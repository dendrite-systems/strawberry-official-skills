{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dendrite-systems/strawberry-official-skills/blob/main/contracts/strawberry-metadata.schema.json",
  "title": "Strawberry metadata",
  "oneOf": [
    {
      "$ref": "#/$defs/officialSkill"
    },
    {
      "$ref": "#/$defs/plugin"
    }
  ],
  "$defs": {
    "roleId": {
      "type": "string",
      "enum": [
        "founder-executive",
        "agency",
        "consultant",
        "sales-business-development",
        "marketing-content",
        "recruiting-people",
        "customer-support-success",
        "operations-chief-of-staff",
        "engineering-development",
        "data-analytics",
        "research-analysis",
        "design",
        "finance",
        "venture-capital",
        "legal",
        "healthcare",
        "education",
        "student",
        "writer-creator",
        "other"
      ]
    },
    "roleUseCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleId", "weight", "title", "message"],
      "properties": {
        "roleId": {
          "$ref": "#/$defs/roleId"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "officialSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "skillType",
        "id",
        "displayName",
        "summary",
        "icon",
        "difficulty",
        "tags",
        "useCases"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "official-skill"
        },
        "skillType": {
          "enum": ["focused", "playbook"]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "icon": {
          "enum": [
            "binoculars",
            "books",
            "calendar",
            "chart",
            "code",
            "files",
            "inbox",
            "lightbulb",
            "people",
            "presentation",
            "receipt",
            "sparkles"
          ]
        },
        "difficulty": {
          "enum": ["straightforward", "moderate", "advanced"]
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["good-first-skill"]
          }
        },
        "useCases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/roleUseCase"
          }
        },
        "pluginIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "skillIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "displayName",
        "summary",
        "playbookSkillId",
        "skillIds"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "plugin"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "playbookSkillId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "skillIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
